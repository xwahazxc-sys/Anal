# Скопируйте в .env (он в .gitignore). НИКОГДА не коммитьте реальные ключи.
ANTHROPIC_API_KEY=
JOBAGENT_MODEL=claude-sonnet-5-5

# hh.ru: зарегистрируйте приложение на https://dev.hh.ru/admin
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=http://localhost:8080/callback
HH_ACCESS_TOKEN=
HH_USER_AGENT=jobagent/0.1 (you@example.com)
HH_RESUME_ID=

# Лимиты автоотклика
JOBAGENT_DAILY_LIMIT=15
