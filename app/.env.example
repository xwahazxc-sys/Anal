# App (public, ships in the client bundle: anon key only, never the service role key)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Edge function secrets: set with `supabase secrets set NAME=value`, never in the app
REVENUECAT_WEBHOOK_AUTH=
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to edge functions by Supabase

# Build / release (EAS, App Store Connect, Play Console): stored in EAS secrets, not in git
REVENUECAT_APPLE_API_KEY=
REVENUECAT_GOOGLE_API_KEY=
