[{"text": "What if... at 2:14 a.m., your building's group chat lit up... about you?", "t0": 0.208, "t1": 7.28, "words": [["What", 0.208, 0.24], ["if...", 0.347, 1.52], ["at", 1.6, 1.76], ["2:14", 1.84, 2.64], ["a.m.,", 2.76, 3.2], ["your", 3.36, 4.0], ["building's", 4.036, 4.4], ["group", 4.44, 4.64], ["chat", 4.704, 4.96], ["lit", 5.02, 5.2], ["up...", 5.28, 5.52], ["about", 5.76, 6.96], ["you?", 7.0, 7.28]]}, {"text": "\"4B... there's a man standing at your door.\"", "t0": 7.88, "t1": 11.12, "words": [["\"4B...", 7.88, 9.68], ["there's", 9.693, 9.84], ["a", 9.88, 9.92], ["man", 9.98, 10.16], ["standing", 10.204, 10.56], ["at", 10.587, 10.64], ["your", 10.656, 10.72], ["door.\"", 10.784, 11.12]]}, {"text": "You're 4B. You live alone.", "t0": 13.26, "t1": 16.003, "words": [["You're", 13.26, 13.36], ["4B.", 13.52, 14.0], ["You", 15.263, 15.283], ["live", 15.315, 15.443], ["alone.", 15.523, 16.003]]}, {"text": "\"I see him too. Don't open it. Don't even look through the peephole.\"", "t0": 16.803, "t1": 23.043, "words": [["\"I", 16.803, 17.683], ["see", 17.743, 17.923], ["him", 17.943, 18.003], ["too.", 18.103, 18.883], ["Don't", 19.003, 19.443], ["open", 19.491, 19.683], ["it.", 19.736, 19.923], ["Don't", 20.163, 21.003], ["even", 21.027, 21.123], ["look", 21.155, 21.283], ["through", 21.303, 21.443], ["the", 21.463, 21.523], ["peephole.\"", 21.576, 23.043]]}, {"text": "So you open the hallway camera instead.", "t0": 23.363, "t1": 25.923, "words": [["So", 23.363, 24.003], ["you", 24.043, 24.163], ["open", 24.227, 24.483], ["the", 24.503, 24.563], ["hallway", 24.603, 24.883], ["camera", 24.952, 25.363], ["instead.", 25.423, 25.923]]}, {"text": "The hallway is empty.", "t0": 27.583, "t1": 28.563, "words": [["The", 27.583, 27.603], ["hallway", 27.653, 28.003], ["is", 28.03, 28.083], ["empty.", 28.15, 28.563]]}, {"text": "\"He just put his ear against your door.\"", "t0": 29.203, "t1": 32.243, "words": [["\"He", 29.203, 29.923], ["just", 29.955, 30.083], ["put", 30.123, 30.243], ["his", 30.283, 30.403], ["ear", 30.463, 30.643], ["against", 30.683, 30.963], ["your", 30.979, 31.043], ["door.\"", 31.123, 32.243]]}, {"text": "You look again. Still empty.", "t0": 32.443, "t1": 35.609, "words": [["You", 32.443, 33.043], ["look", 33.075, 33.203], ["again.", 33.27, 34.283], ["Still", 35.109, 35.209], ["empty.", 35.262, 35.609]]}, {"text": "\"4B... why are you sitting so still?\"", "t0": 36.289, "t1": 39.369, "words": [["\"4B...", 36.289, 37.809], ["why", 37.919, 38.249], ["are", 38.289, 38.409], ["you", 38.429, 38.489], ["sitting", 38.529, 38.809], ["so", 38.862, 38.969], ["still?\"", 39.022, 39.369]]}, {"text": "You haven't moved. You haven't said a word.", "t0": 40.835, "t1": 43.455, "words": [["You", 40.835, 40.895], ["haven't", 40.935, 41.215], ["moved.", 41.268, 41.615], ["You", 41.835, 42.495], ["haven't", 42.522, 42.735], ["said", 42.767, 42.895], ["a", 42.935, 42.975], ["word.", 43.055, 43.455]]}, {"text": "Then the building manager writes.", "t0": 43.759, "t1": 46.855, "words": [["Then", 43.759, 44.975], ["the", 44.995, 45.055], ["building", 45.091, 45.375], ["manager", 45.425, 45.775], ["writes.", 45.832, 46.855]]}, {"text": "\"The hallway camera has been broken since Tuesday. What are you all watching?\"", "t0": 47.195, "t1": 52.015, "words": [["\"The", 47.195, 47.615], ["hallway", 47.655, 47.935], ["camera", 47.992, 48.335], ["has", 48.375, 48.495], ["been", 48.527, 48.655], ["broken", 48.701, 48.975], ["since", 49.015, 49.215], ["Tuesday.", 49.275, 49.775], ["What", 49.967, 50.735], ["are", 50.755, 50.815], ["you", 50.855, 50.975], ["all", 51.015, 51.135], ["watching?\"", 51.188, 52.015]]}, {"text": "The chat goes silent.", "t0": 53.275, "t1": 54.415, "words": [["The", 53.275, 53.295], ["chat", 53.343, 53.535], ["goes", 53.599, 53.855], ["silent.", 53.924, 54.415]]}, {"text": "Dev sends a screenshot.", "t0": 54.735, "t1": 56.735, "words": [["Dev", 54.735, 55.695], ["sends", 55.735, 55.935], ["a", 55.975, 56.015], ["screenshot.", 56.073, 56.735]]}, {"text": "It's not the hallway. It's your living room.", "t0": 57.886, "t1": 61.386, "words": [["It's", 57.886, 58.019], ["not", 58.059, 58.179], ["the", 58.199, 58.259], ["hallway.", 58.329, 59.379], ["It's", 59.973, 60.106], ["your", 60.138, 60.266], ["living", 60.3, 60.506], ["room.", 60.57, 61.386]]}, {"text": "You're on the couch. And behind the couch, facing your door... is him.", "t0": 61.526, "t1": 67.706, "words": [["You're", 61.526, 62.026], ["on", 62.053, 62.106], ["the", 62.146, 62.266], ["couch.", 62.333, 63.266], ["And", 63.416, 63.866], ["behind", 63.923, 64.266], ["the", 64.286, 64.346], ["couch,", 64.413, 65.226], ["facing", 65.283, 65.626], ["your", 65.642, 65.706], ["door...", 65.786, 67.146], ["is", 67.199, 67.306], ["him.", 67.386, 67.706]]}, {"text": "You check the member list. Twelve apartments. Thirteen members.", "t0": 68.066, "t1": 74.306, "words": [["You", 68.066, 69.146], ["check", 69.199, 69.466], ["the", 69.486, 69.546], ["member", 69.58, 69.786], ["list.", 69.866, 70.187], ["Twelve", 70.357, 71.386], ["apartments.", 71.437, 72.106], ["Thirteen", 72.346, 73.146], ["members.", 73.216, 74.306]]}, {"text": "The thirteenth is called... 4B.", "t0": 74.456, "t1": 77.626, "words": [["The", 74.456, 74.906], ["thirteenth", 74.933, 75.466], ["is", 75.519, 75.626], ["called...", 75.672, 76.906], ["4B.", 76.986, 77.626]]}, {"text": "\"Don't turn around.\"", "t0": 79.036, "t1": 79.866, "words": [["\"Don't", 79.036, 79.226], ["turn", 79.258, 79.386], ["around.\"", 79.443, 79.866]]}, {"text": "Would you turn around? Night two is coming.", "t0": 80.789, "t1": 84.589, "words": [["Would", 80.789, 81.389], ["you", 81.409, 81.469], ["turn", 81.517, 81.709], ["around?", 81.766, 82.189], ["Night", 82.442, 83.709], ["two", 83.769, 83.949], ["is", 84.002, 84.109], ["coming.", 84.166, 84.589]]}]