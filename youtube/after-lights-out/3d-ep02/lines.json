[{"text": "Last night... you didn't turn around.", "t0": 0.336, "t1": 3.44, "words": [["Last", 0.336, 0.4], ["night...", 0.467, 1.04], ["you", 1.38, 2.4], ["didn't", 2.448, 2.72], ["turn", 2.752, 2.88], ["around.", 2.949, 3.44]]}, {"text": "You sat on that couch until the sun came up. Nothing happened.", "t0": 3.82, "t1": 9.76, "words": [["You", 3.82, 4.96], ["sat", 5.02, 5.2], ["on", 5.253, 5.36], ["that", 5.392, 5.52], ["couch", 5.6, 6.0], ["until", 6.08, 6.48], ["the", 6.5, 6.56], ["sun", 6.64, 6.88], ["came", 6.944, 7.2], ["up.", 7.28, 7.52], ["Nothing", 7.72, 9.12], ["happened.", 9.173, 9.76]]}, {"text": "In the morning, the thirteenth member was gone.", "t0": 10.24, "t1": 14.879, "words": [["In", 10.24, 11.2], ["the", 11.24, 11.36], ["morning,", 11.41, 13.04], ["the", 13.08, 13.2], ["thirteenth", 13.253, 13.76], ["member", 13.806, 14.08], ["was", 14.14, 14.32], ["gone.", 14.4, 14.879]]}, {"text": "Tonight, at 2:14, your phone lights up again.", "t0": 15.67, "t1": 21.04, "words": [["Tonight,", 15.67, 17.92], ["at", 17.973, 18.08], ["2:14,", 18.16, 19.12], ["your", 19.264, 19.84], ["phone", 19.893, 20.16], ["lights", 20.206, 20.48], ["up", 20.533, 20.64], ["again.", 20.693, 21.04]]}, {"text": "\"Good news, everyone. The hallway cam is back.\"", "t0": 21.92, "t1": 26.0, "words": [["\"Good", 21.92, 22.88], ["news,", 22.944, 23.2], ["everyone.", 23.253, 23.76], ["The", 23.96, 24.56], ["hallway", 24.62, 25.04], ["cam", 25.12, 25.36], ["is", 25.413, 25.52], ["back.\"", 25.6, 26.0]]}, {"text": "Someone is standing at your door. Facing it. Not moving.", "t0": 27.863, "t1": 32.323, "words": [["Someone", 27.863, 28.003], ["is", 28.03, 28.083], ["standing", 28.127, 28.483], ["at", 28.51, 28.563], ["your", 28.595, 28.723], ["door.", 28.803, 29.203], ["Facing", 29.363, 30.323], ["it.", 30.403, 30.643], ["Not", 30.923, 31.763], ["moving.", 31.82, 32.323]]}, {"text": "Grey hoodie. Hood up.", "t0": 32.611, "t1": 35.523, "words": [["Grey", 32.611, 33.763], ["hoodie.", 33.82, 34.243], ["Hood", 34.419, 35.123], ["up.", 35.23, 35.523]]}, {"text": "Your hoodie.", "t0": 37.155, "t1": 38.643, "words": [["Your", 37.155, 37.203], ["hoodie.", 37.272, 38.643]]}, {"text": "\"4B... is that you out there?\"", "t0": 39.123, "t1": 42.323, "words": [["\"4B...", 39.123, 40.243], ["is", 40.616, 41.363], ["that", 41.411, 41.603], ["you", 41.643, 41.763], ["out", 41.803, 41.923], ["there?\"", 41.976, 42.323]]}, {"text": "You look down. You're still on the couch.", "t0": 44.108, "t1": 46.888, "words": [["You", 44.108, 44.168], ["look", 44.216, 44.408], ["down.", 44.488, 44.888], ["You're", 45.128, 45.928], ["still", 45.968, 46.168], ["on", 46.195, 46.248], ["the", 46.268, 46.328], ["couch.", 46.408, 46.888]]}, {"text": "Then the figure on the camera lifts its hand... and knocks.", "t0": 47.192, "t1": 52.488, "words": [["Then", 47.192, 48.408], ["the", 48.428, 48.488], ["figure", 48.545, 48.888], ["on", 48.915, 48.968], ["the", 49.008, 49.128], ["camera", 49.185, 49.528], ["lifts", 49.581, 49.848], ["its", 49.888, 50.008], ["hand...", 50.104, 51.528], ["and", 51.568, 51.688], ["knocks.", 51.779, 52.488]]}, {"text": "Three knocks. On your door.", "t0": 54.181, "t1": 56.648, "words": [["Three", 54.181, 54.248], ["knocks.", 54.328, 54.888], ["On", 55.235, 55.928], ["your", 55.976, 56.168], ["door.", 56.248, 56.648]]}, {"text": "\"4B, why won't you let yourself in?\"", "t0": 57.408, "t1": 60.808, "words": [["\"4B,", 57.408, 58.728], ["why", 58.948, 59.608], ["won't", 59.648, 59.848], ["you", 59.868, 59.928], ["let", 59.968, 60.088], ["yourself", 60.132, 60.488], ["in?\"", 60.568, 60.808]]}, {"text": "Then you hear a key. Your key. Turning in your lock.", "t0": 61.752, "t1": 67.448, "words": [["Then", 61.752, 62.648], ["you", 62.668, 62.728], ["hear", 62.76, 62.888], ["a", 62.968, 63.048], ["key.", 63.148, 64.088], ["Your", 64.216, 64.728], ["key.", 64.808, 65.128], ["Turning", 65.308, 66.568], ["in", 66.595, 66.648], ["your", 66.68, 66.808], ["lock.", 66.888, 67.448]]}, {"text": "The door opens... and there's nobody there.", "t0": 67.788, "t1": 72.608, "words": [["The", 67.788, 68.808], ["door", 68.856, 69.048], ["opens...", 69.141, 69.768], ["and", 70.028, 70.808], ["there's", 70.835, 71.048], ["nobody", 71.094, 71.368], ["there.", 71.435, 72.608]]}, {"text": "Just the hallway light... and one new message.", "t0": 72.776, "t1": 76.648, "words": [["Just", 72.776, 73.448], ["the", 73.488, 73.608], ["hallway", 73.658, 74.008], ["light...", 74.061, 75.368], ["and", 75.408, 75.528], ["one", 75.588, 75.768], ["new", 75.828, 76.008], ["message.", 76.078, 76.648]]}, {"text": "From you.", "t0": 78.28, "t1": 78.728, "words": [["From", 78.28, 78.328], ["you.", 78.408, 78.728]]}, {"text": "\"I'm home. Who's on my couch?\"", "t0": 79.608, "t1": 83.528, "words": [["\"I'm", 79.608, 80.648], ["home.", 80.728, 81.808], ["Who's", 81.998, 82.648], ["on", 82.701, 82.808], ["my", 82.888, 83.048], ["couch?\"", 83.115, 83.528]]}, {"text": "Would you answer it? Night three is coming.", "t0": 85.564, "t1": 88.888, "words": [["Would", 85.564, 85.608], ["you", 85.628, 85.688], ["answer", 85.745, 86.088], ["it?", 86.141, 86.328], ["Night", 86.595, 87.928], ["three", 87.995, 88.328], ["is", 88.381, 88.488], ["coming.", 88.534, 88.888]]}]